<div class="space-y-6">
  <div>
    <h1 class="text-2xl font-bold text-gray-900">AI Content Assistant</h1>
    <p class="mt-1 text-sm text-gray-500">Generate SEO-optimized content with AI</p>
  </div>

  <% unless ENV["OPENAI_API_KEY"].present? %>
    <div class="bg-yellow-50 border border-yellow-200 rounded-md p-4">
      <div class="flex">
        <div class="flex-shrink-0">
          <svg class="h-5 w-5 text-yellow-400" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
          </svg>
        </div>
        <div class="ml-3">
          <h3 class="text-sm font-medium text-yellow-800">API Key Not Configured</h3>
          <p class="mt-2 text-sm text-yellow-700">
            OpenAI API key is not set. Mock responses will be used. To enable AI features, set the OPENAI_API_KEY environment variable.
          </p>
        </div>
      </div>
    </div>
  <% end %>

  <!-- Title Generator -->
  <div class="bg-white shadow rounded-lg p-6" data-controller="ai-titles">
    <h3 class="text-lg font-medium text-gray-900 mb-4">Title Generator</h3>
    <div class="space-y-4">
      <div>
        <label for="title-keyword" class="block text-sm font-medium text-gray-700">Target Keyword</label>
        <input type="text" id="title-keyword" data-ai-titles-target="keyword"
          class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-teal-500 focus:border-teal-500 sm:text-sm"
          placeholder="Enter your target keyword...">
      </div>
      <div>
        <label for="current-title" class="block text-sm font-medium text-gray-700">Current Title (optional)</label>
        <input type="text" id="current-title" data-ai-titles-target="currentTitle"
          class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-teal-500 focus:border-teal-500 sm:text-sm"
          placeholder="Your current title for improvement...">
      </div>
      <button type="button" data-action="click->ai-titles#generate"
        class="inline-flex items-center px-4 py-2 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-teal-600 hover:bg-teal-700">
        <svg class="-ml-1 mr-2 h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
        </svg>
        Generate Titles
      </button>
      <div id="title-results" data-ai-titles-target="results" class="hidden mt-4">
        <h4 class="text-sm font-medium text-gray-700 mb-2">Suggested Titles:</h4>
        <ul class="space-y-2" data-ai-titles-target="list"></ul>
      </div>
    </div>
  </div>

  <!-- Outline Generator -->
  <div class="bg-white shadow rounded-lg p-6" data-controller="ai-outline">
    <h3 class="text-lg font-medium text-gray-900 mb-4">Outline Generator</h3>
    <div class="space-y-4">
      <div>
        <label for="outline-keyword" class="block text-sm font-medium text-gray-700">Target Keyword</label>
        <input type="text" id="outline-keyword" data-ai-outline-target="keyword"
          class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-teal-500 focus:border-teal-500 sm:text-sm"
          placeholder="Enter your target keyword...">
      </div>
      <div>
        <label for="outline-title" class="block text-sm font-medium text-gray-700">Article Title</label>
        <input type="text" id="outline-title" data-ai-outline-target="title"
          class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-teal-500 focus:border-teal-500 sm:text-sm"
          placeholder="Your article title...">
      </div>
      <button type="button" data-action="click->ai-outline#generate"
        class="inline-flex items-center px-4 py-2 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-teal-600 hover:bg-teal-700">
        <svg class="-ml-1 mr-2 h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 10h16M4 14h16M4 18h16" />
        </svg>
        Generate Outline
      </button>
      <div id="outline-results" data-ai-outline-target="results" class="hidden mt-4">
        <h4 class="text-sm font-medium text-gray-700 mb-2">Suggested Outline:</h4>
        <div data-ai-outline-target="content" class="prose prose-sm max-w-none"></div>
      </div>
    </div>
  </div>

  <!-- Meta Description Generator -->
  <div class="bg-white shadow rounded-lg p-6" data-controller="ai-meta">
    <h3 class="text-lg font-medium text-gray-900 mb-4">Meta Description Generator</h3>
    <div class="space-y-4">
      <div>
        <label for="meta-keyword" class="block text-sm font-medium text-gray-700">Target Keyword</label>
        <input type="text" id="meta-keyword" data-ai-meta-target="keyword"
          class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-teal-500 focus:border-teal-500 sm:text-sm"
          placeholder="Enter your target keyword...">
      </div>
      <button type="button" data-action="click->ai-meta#generate"
        class="inline-flex items-center px-4 py-2 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-teal-600 hover:bg-teal-700">
        <svg class="-ml-1 mr-2 h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 8h10M7 12h4m1 8l-4-4H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-3l-4 4z" />
        </svg>
        Generate Meta Description
      </button>
      <div id="meta-results" data-ai-meta-target="results" class="hidden mt-4">
        <h4 class="text-sm font-medium text-gray-700 mb-2">Suggested Meta Description:</h4>
        <div data-ai-meta-target="content" class="p-3 bg-gray-50 rounded-md text-sm text-gray-700"></div>
        <p class="mt-2 text-xs text-gray-500">
          Characters: <span data-ai-meta-target="charCount">0</span>/155
        </p>
      </div>
    </div>
  </div>

  <!-- Article Rewrite Suggestions -->
  <% if @sites.any? %>
    <div class="bg-white shadow rounded-lg p-6">
      <h3 class="text-lg font-medium text-gray-900 mb-4">Article Rewrite Suggestions</h3>
      <p class="text-sm text-gray-500 mb-4">
        Get AI-powered suggestions to improve your existing articles. Go to any article's detail page and click "Get AI Suggestions" to analyze and receive improvement recommendations.
      </p>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <% @sites.each do |site| %>
          <% if site.articles.any? %>
            <div class="border border-gray-200 rounded-lg p-4">
              <h4 class="font-medium text-gray-900"><%= site.name %></h4>
              <p class="text-sm text-gray-500 mt-1"><%= site.articles.count %> articles</p>
              <%= link_to site_articles_path(site), class: "mt-2 inline-flex text-sm text-teal-600 hover:text-teal-500" do %>
                View Articles &rarr;
              <% end %>
            </div>
          <% end %>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
