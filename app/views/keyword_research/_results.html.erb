<%= turbo_frame_tag "search-results" do %>
  <div class="space-y-6">
    <!-- Main Keyword Analysis -->
    <div class="bg-white shadow rounded-lg overflow-hidden">
      <div class="px-4 py-5 border-b border-gray-200 sm:px-6">
        <h3 class="text-lg leading-6 font-medium text-gray-900">
          "<%= results[:main_keyword][:keyword] %>"
        </h3>
      </div>
      <div class="p-6">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
          <div class="text-center p-4 bg-gray-50 rounded-lg">
            <dt class="text-sm font-medium text-gray-500">Search Volume</dt>
            <dd class="mt-1 text-2xl font-semibold text-gray-900">
              <%= number_with_delimiter(results[:main_keyword][:search_volume]) %>
            </dd>
            <dd class="text-xs text-gray-500">monthly</dd>
          </div>
          <div class="text-center p-4 bg-gray-50 rounded-lg">
            <dt class="text-sm font-medium text-gray-500">Difficulty</dt>
            <dd class="mt-1">
              <span class="inline-flex items-center px-3 py-1 rounded-full text-lg font-semibold
                <%= case results[:main_keyword][:difficulty][:color]
                    when 'green' then 'bg-green-100 text-green-800'
                    when 'yellow' then 'bg-yellow-100 text-yellow-800'
                    when 'red' then 'bg-red-100 text-red-800'
                    end %>">
                <%= results[:main_keyword][:difficulty][:score] %>
              </span>
            </dd>
            <dd class="text-xs text-gray-500"><%= results[:main_keyword][:difficulty][:level] %></dd>
          </div>
          <div class="text-center p-4 bg-gray-50 rounded-lg">
            <dt class="text-sm font-medium text-gray-500">CPC</dt>
            <dd class="mt-1 text-2xl font-semibold text-gray-900">
              ¥<%= results[:main_keyword][:cpc] %>
            </dd>
            <dd class="text-xs text-gray-500">avg.</dd>
          </div>
          <div class="text-center p-4 bg-gray-50 rounded-lg">
            <dt class="text-sm font-medium text-gray-500">Trend</dt>
            <dd class="mt-1 text-2xl font-semibold <%= results[:main_keyword][:trend] >= 0 ? 'text-green-600' : 'text-red-600' %>">
              <%= results[:main_keyword][:trend] >= 0 ? '+' : '' %><%= results[:main_keyword][:trend] %>%
            </dd>
            <dd class="text-xs text-gray-500">vs last year</dd>
          </div>
        </div>

        <% if site %>
          <div class="mt-4 flex justify-end">
            <%= button_to "Add to #{site.name}", site_keywords_path(site, keyword: { word: results[:main_keyword][:keyword] }),
                method: :post,
                class: "inline-flex items-center px-4 py-2 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-teal-600 hover:bg-teal-700" %>
          </div>
        <% end %>
      </div>
    </div>

    <!-- Related Keywords -->
    <% if results[:related_keywords].any? %>
      <div class="bg-white shadow rounded-lg overflow-hidden">
        <div class="px-4 py-5 border-b border-gray-200 sm:px-6">
          <h3 class="text-lg leading-6 font-medium text-gray-900">Related Keywords</h3>
        </div>
        <div class="overflow-x-auto">
          <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50">
              <tr>
                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Keyword</th>
                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Volume</th>
                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Difficulty</th>
                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">CPC</th>
                <% if site %>
                  <th scope="col" class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Action</th>
                <% end %>
              </tr>
            </thead>
            <tbody class="bg-white divide-y divide-gray-200">
              <% results[:related_keywords].each do |kw| %>
                <tr>
                  <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">
                    <%= kw[:keyword] %>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                    <%= number_with_delimiter(kw[:search_volume]) %>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap">
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium
                      <%= case kw[:difficulty][:color]
                          when 'green' then 'bg-green-100 text-green-800'
                          when 'yellow' then 'bg-yellow-100 text-yellow-800'
                          when 'red' then 'bg-red-100 text-red-800'
                          end %>">
                      <%= kw[:difficulty][:level] %> (<%= kw[:difficulty][:score] %>)
                    </span>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                    ¥<%= kw[:cpc] %>
                  </td>
                  <% if site %>
                    <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                      <%= button_to "Add", site_keywords_path(site, keyword: { word: kw[:keyword] }),
                          method: :post,
                          class: "text-teal-600 hover:text-teal-900" %>
                    </td>
                  <% end %>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    <% end %>

    <!-- Long-tail Keywords -->
    <% if results[:long_tail_keywords].any? %>
      <div class="bg-white shadow rounded-lg overflow-hidden">
        <div class="px-4 py-5 border-b border-gray-200 sm:px-6">
          <h3 class="text-lg leading-6 font-medium text-gray-900">Long-tail Keywords</h3>
          <p class="mt-1 text-sm text-gray-500">Lower competition, higher conversion potential</p>
        </div>
        <div class="overflow-x-auto">
          <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50">
              <tr>
                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Keyword</th>
                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Volume</th>
                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Difficulty</th>
                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">CPC</th>
                <% if site %>
                  <th scope="col" class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Action</th>
                <% end %>
              </tr>
            </thead>
            <tbody class="bg-white divide-y divide-gray-200">
              <% results[:long_tail_keywords].each do |kw| %>
                <tr>
                  <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">
                    <%= kw[:keyword] %>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                    <%= number_with_delimiter(kw[:search_volume]) %>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap">
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium
                      <%= case kw[:difficulty][:color]
                          when 'green' then 'bg-green-100 text-green-800'
                          when 'yellow' then 'bg-yellow-100 text-yellow-800'
                          when 'red' then 'bg-red-100 text-red-800'
                          end %>">
                      <%= kw[:difficulty][:level] %> (<%= kw[:difficulty][:score] %>)
                    </span>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                    ¥<%= kw[:cpc] %>
                  </td>
                  <% if site %>
                    <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                      <%= button_to "Add", site_keywords_path(site, keyword: { word: kw[:keyword] }),
                          method: :post,
                          class: "text-teal-600 hover:text-teal-900" %>
                    </td>
                  <% end %>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    <% end %>
  </div>
<% end %>
