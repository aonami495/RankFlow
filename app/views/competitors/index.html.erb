<div class="space-y-6">
  <div class="flex justify-between items-center">
    <div>
      <div class="flex items-center">
        <%= link_to site_path(@site), class: "text-gray-400 hover:text-gray-600 mr-2" do %>
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
          </svg>
        <% end %>
        <h1 class="text-2xl font-bold text-gray-900">Competitor Analysis - <%= @site.name %></h1>
      </div>
      <p class="mt-1 text-sm text-gray-500">Track and compare your rankings against competitors</p>
    </div>
    <%= link_to new_site_competitor_path(@site), class: "inline-flex items-center px-4 py-2 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-teal-600 hover:bg-teal-700" do %>
      <svg class="-ml-1 mr-2 h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
      </svg>
      Add Competitor
    <% end %>
  </div>

  <% if @competitors.any? %>
    <!-- Competitor Cards -->
    <div class="grid grid-cols-1 gap-6 lg:grid-cols-2">
      <% @competitors.each do |competitor| %>
        <div class="bg-white shadow rounded-lg overflow-hidden">
          <div class="px-4 py-5 border-b border-gray-200 sm:px-6">
            <div class="flex justify-between items-center">
              <div>
                <h3 class="text-lg font-medium text-gray-900"><%= competitor.name %></h3>
                <p class="text-sm text-gray-500"><%= competitor.domain %></p>
              </div>
              <div class="flex space-x-2">
                <%= link_to site_competitor_path(@site, competitor), class: "text-teal-600 hover:text-teal-900 text-sm font-medium" do %>
                  Compare
                <% end %>
                <%= link_to "Edit", edit_site_competitor_path(@site, competitor), class: "text-gray-600 hover:text-gray-900 text-sm font-medium" %>
                <%= button_to "Remove", site_competitor_path(@site, competitor), method: :delete, data: { turbo_confirm: "Remove this competitor?" }, class: "text-red-600 hover:text-red-900 text-sm font-medium" %>
              </div>
            </div>
          </div>
          <div class="px-4 py-4 sm:px-6">
            <div class="grid grid-cols-2 gap-4">
              <div>
                <dt class="text-sm font-medium text-gray-500">Average Rank</dt>
                <dd class="mt-1 text-2xl font-semibold text-gray-900">
                  <%= competitor.average_rank || "-" %>
                </dd>
              </div>
              <div>
                <dt class="text-sm font-medium text-gray-500">Keywords Tracked</dt>
                <dd class="mt-1 text-2xl font-semibold text-gray-900">
                  <%= competitor.competitor_rank_histories.select(:keyword_id).distinct.count %>
                </dd>
              </div>
            </div>
            <% if competitor.notes.present? %>
              <div class="mt-4">
                <dt class="text-sm font-medium text-gray-500">Notes</dt>
                <dd class="mt-1 text-sm text-gray-600"><%= competitor.notes %></dd>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>

    <!-- Comparison Table -->
    <% if @keywords.any? %>
      <div class="bg-white shadow rounded-lg overflow-hidden">
        <div class="px-4 py-5 border-b border-gray-200 sm:px-6">
          <h3 class="text-lg leading-6 font-medium text-gray-900">Rank Comparison</h3>
        </div>
        <div class="overflow-x-auto">
          <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50">
              <tr>
                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Keyword</th>
                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Your Rank</th>
                <% @competitors.each do |competitor| %>
                  <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"><%= competitor.name %></th>
                <% end %>
              </tr>
            </thead>
            <tbody class="bg-white divide-y divide-gray-200">
              <% @keywords.each do |keyword| %>
                <tr>
                  <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">
                    <%= keyword.word %>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap">
                    <% my_rank = keyword.current_rank %>
                    <% if my_rank && my_rank <= 100 %>
                      <span class="text-lg font-semibold text-gray-900"><%= my_rank %></span>
                    <% elsif my_rank == 101 %>
                      <span class="text-sm text-gray-500">100+</span>
                    <% else %>
                      <span class="text-sm text-gray-400">-</span>
                    <% end %>
                  </td>
                  <% @competitors.each do |competitor| %>
                    <td class="px-6 py-4 whitespace-nowrap">
                      <% comp_rank = competitor.current_rank_for(keyword) %>
                      <% if comp_rank && comp_rank <= 100 %>
                        <span class="text-lg font-semibold <%= comp_rank < (my_rank || 101) ? 'text-red-600' : 'text-green-600' %>">
                          <%= comp_rank %>
                        </span>
                      <% elsif comp_rank == 101 %>
                        <span class="text-sm text-gray-500">100+</span>
                      <% else %>
                        <span class="text-sm text-gray-400">-</span>
                      <% end %>
                    </td>
                  <% end %>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    <% end %>
  <% else %>
    <div class="bg-white rounded-lg shadow p-8 text-center">
      <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
      </svg>
      <h3 class="mt-2 text-sm font-medium text-gray-900">No competitors yet</h3>
      <p class="mt-1 text-sm text-gray-500">Add competitors to track and compare rankings.</p>
      <div class="mt-6">
        <%= link_to "Add Competitor", new_site_competitor_path(@site), class: "inline-flex items-center px-4 py-2 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-teal-600 hover:bg-teal-700" %>
      </div>
    </div>
  <% end %>
</div>
