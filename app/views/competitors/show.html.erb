<div class="space-y-6">
  <div class="flex justify-between items-center">
    <div>
      <div class="flex items-center">
        <%= link_to site_competitors_path(@site), class: "text-gray-400 hover:text-gray-600 mr-2" do %>
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
          </svg>
        <% end %>
        <h1 class="text-2xl font-bold text-gray-900"><%= @competitor.name %></h1>
      </div>
      <p class="mt-1 text-sm text-gray-500"><%= @competitor.url %></p>
    </div>
    <div class="flex space-x-3">
      <%= link_to "Edit", edit_site_competitor_path(@site, @competitor), class: "inline-flex items-center px-3 py-2 border border-gray-300 shadow-sm text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50" %>
    </div>
  </div>

  <!-- Summary Cards -->
  <div class="grid grid-cols-1 gap-5 sm:grid-cols-4">
    <div class="bg-white overflow-hidden shadow rounded-lg">
      <div class="p-5">
        <dt class="text-sm font-medium text-gray-500 truncate">Your Avg Rank</dt>
        <dd class="mt-1 text-2xl font-semibold text-gray-900"><%= @site.average_rank || "-" %></dd>
      </div>
    </div>
    <div class="bg-white overflow-hidden shadow rounded-lg">
      <div class="p-5">
        <dt class="text-sm font-medium text-gray-500 truncate">Competitor Avg Rank</dt>
        <dd class="mt-1 text-2xl font-semibold text-gray-900"><%= @competitor.average_rank || "-" %></dd>
      </div>
    </div>
    <div class="bg-white overflow-hidden shadow rounded-lg">
      <div class="p-5">
        <dt class="text-sm font-medium text-gray-500 truncate">You're Winning</dt>
        <dd class="mt-1 text-2xl font-semibold text-green-600">
          <%= @rank_comparison.count { |r| r[:difference] && r[:difference] > 0 } %>
        </dd>
      </div>
    </div>
    <div class="bg-white overflow-hidden shadow rounded-lg">
      <div class="p-5">
        <dt class="text-sm font-medium text-gray-500 truncate">Competitor Winning</dt>
        <dd class="mt-1 text-2xl font-semibold text-red-600">
          <%= @rank_comparison.count { |r| r[:difference] && r[:difference] < 0 } %>
        </dd>
      </div>
    </div>
  </div>

  <!-- Detailed Comparison -->
  <div class="bg-white shadow rounded-lg overflow-hidden">
    <div class="px-4 py-5 border-b border-gray-200 sm:px-6">
      <h3 class="text-lg leading-6 font-medium text-gray-900">Keyword-by-Keyword Comparison</h3>
    </div>
    <% if @rank_comparison.any? %>
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200">
          <thead class="bg-gray-50">
            <tr>
              <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Keyword</th>
              <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Your Rank</th>
              <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Competitor</th>
              <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Difference</th>
              <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
            </tr>
          </thead>
          <tbody class="bg-white divide-y divide-gray-200">
            <% @rank_comparison.each do |comparison| %>
              <tr>
                <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">
                  <%= comparison[:keyword].word %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                  <% if comparison[:my_rank] && comparison[:my_rank] <= 100 %>
                    <span class="text-lg font-semibold text-gray-900"><%= comparison[:my_rank] %></span>
                    <% if comparison[:my_change] %>
                      <span class="ml-1 text-sm <%= comparison[:my_change] > 0 ? 'text-green-600' : comparison[:my_change] < 0 ? 'text-red-600' : 'text-gray-400' %>">
                        (<%= comparison[:my_change] > 0 ? '+' : '' %><%= comparison[:my_change] %>)
                      </span>
                    <% end %>
                  <% elsif comparison[:my_rank] == 101 %>
                    <span class="text-sm text-gray-500">100+</span>
                  <% else %>
                    <span class="text-sm text-gray-400">-</span>
                  <% end %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                  <% if comparison[:competitor_rank] && comparison[:competitor_rank] <= 100 %>
                    <span class="text-lg font-semibold text-gray-900"><%= comparison[:competitor_rank] %></span>
                    <% if comparison[:competitor_change] %>
                      <span class="ml-1 text-sm <%= comparison[:competitor_change] > 0 ? 'text-green-600' : comparison[:competitor_change] < 0 ? 'text-red-600' : 'text-gray-400' %>">
                        (<%= comparison[:competitor_change] > 0 ? '+' : '' %><%= comparison[:competitor_change] %>)
                      </span>
                    <% end %>
                  <% elsif comparison[:competitor_rank] == 101 %>
                    <span class="text-sm text-gray-500">100+</span>
                  <% else %>
                    <span class="text-sm text-gray-400">-</span>
                  <% end %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                  <% if comparison[:difference] %>
                    <span class="text-lg font-semibold <%= comparison[:difference] > 0 ? 'text-green-600' : comparison[:difference] < 0 ? 'text-red-600' : 'text-gray-400' %>">
                      <%= comparison[:difference] > 0 ? '+' : '' %><%= comparison[:difference] %>
                    </span>
                  <% else %>
                    <span class="text-sm text-gray-400">-</span>
                  <% end %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                  <% if comparison[:difference] %>
                    <% if comparison[:difference] > 5 %>
                      <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                        Leading
                      </span>
                    <% elsif comparison[:difference] < -5 %>
                      <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-800">
                        Behind
                      </span>
                    <% else %>
                      <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-yellow-100 text-yellow-800">
                        Close
                      </span>
                    <% end %>
                  <% else %>
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-800">
                      No Data
                    </span>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="p-8 text-center">
        <p class="text-sm text-gray-500">No keywords to compare yet.</p>
      </div>
    <% end %>
  </div>
</div>
