<%= form_with(model: [site, keyword], class: "space-y-6") do |form| %>
  <% if keyword.errors.any? %>
    <div class="bg-red-50 border border-red-200 rounded-md p-4">
      <div class="flex">
        <div class="flex-shrink-0">
          <svg class="h-5 w-5 text-red-400" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" />
          </svg>
        </div>
        <div class="ml-3">
          <h3 class="text-sm font-medium text-red-800">
            <%= pluralize(keyword.errors.count, "error") %> prohibited this keyword from being saved:
          </h3>
          <div class="mt-2 text-sm text-red-700">
            <ul class="list-disc pl-5 space-y-1">
              <% keyword.errors.each do |error| %>
                <li><%= error.full_message %></li>
              <% end %>
            </ul>
          </div>
        </div>
      </div>
    </div>
  <% end %>

  <div>
    <%= form.label :word, "Keyword", class: "block text-sm font-medium text-gray-700" %>
    <%= form.text_field :word, class: "mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm placeholder-gray-400 focus:outline-none focus:ring-teal-500 focus:border-teal-500 sm:text-sm", placeholder: "e.g., blog seo tips" %>
    <p class="mt-1 text-sm text-gray-500">Enter the search keyword you want to track</p>
  </div>

  <div>
    <%= form.label :target_url, "Target URL (optional)", class: "block text-sm font-medium text-gray-700" %>
    <%= form.url_field :target_url, class: "mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm placeholder-gray-400 focus:outline-none focus:ring-teal-500 focus:border-teal-500 sm:text-sm", placeholder: "https://example.com/specific-page" %>
    <p class="mt-1 text-sm text-gray-500">If specified, we'll track this specific page. Otherwise, we'll track any page on your site.</p>
  </div>

  <div>
    <%= form.label :article_id, "Associated Article (optional)", class: "block text-sm font-medium text-gray-700" %>
    <%= form.select :article_id,
        options_from_collection_for_select(site.articles.order(:title), :id, :title, keyword.article_id),
        { include_blank: "-- Select Article --" },
        class: "mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-teal-500 focus:border-teal-500 sm:text-sm" %>
    <p class="mt-1 text-sm text-gray-500">Link this keyword to an article for tracking.</p>
  </div>

  <div class="flex justify-end space-x-3">
    <%= link_to "Cancel", site_path(site), class: "px-4 py-2 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-teal-500" %>
    <%= form.submit class: "px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-teal-600 hover:bg-teal-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-teal-500 cursor-pointer" %>
  </div>
<% end %>
