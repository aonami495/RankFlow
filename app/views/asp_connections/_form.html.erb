<%= form_with(model: [@site, asp_connection], class: "space-y-6") do |form| %>
  <% if asp_connection.errors.any? %>
    <div class="bg-red-50 border border-red-200 rounded-md p-4">
      <div class="flex">
        <div class="flex-shrink-0">
          <svg class="h-5 w-5 text-red-400" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" />
          </svg>
        </div>
        <div class="ml-3">
          <h3 class="text-sm font-medium text-red-800">
            <%= pluralize(asp_connection.errors.count, "error") %> occurred:
          </h3>
          <div class="mt-2 text-sm text-red-700">
            <ul class="list-disc pl-5 space-y-1">
              <% asp_connection.errors.each do |error| %>
                <li><%= error.full_message %></li>
              <% end %>
            </ul>
          </div>
        </div>
      </div>
    </div>
  <% end %>

  <%= form.hidden_field :asp_name %>

  <% config = asp_connection.asp_config %>

  <% if config[:requires_api_key] %>
    <div>
      <%= form.label :api_key_encrypted, "API Key", class: "block text-sm font-medium text-gray-700" %>
      <%= form.text_field :api_key_encrypted,
          class: "mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm placeholder-gray-400 focus:outline-none focus:ring-teal-500 focus:border-teal-500 sm:text-sm",
          placeholder: "Enter your API key" %>
      <p class="mt-1 text-sm text-gray-500">Your API key from <%= asp_connection.display_name %></p>
    </div>
  <% end %>

  <% if config[:requires_api_secret] %>
    <div>
      <%= form.label :api_secret_encrypted, "API Secret", class: "block text-sm font-medium text-gray-700" %>
      <%= form.password_field :api_secret_encrypted,
          class: "mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm placeholder-gray-400 focus:outline-none focus:ring-teal-500 focus:border-teal-500 sm:text-sm",
          placeholder: "Enter your API secret" %>
      <p class="mt-1 text-sm text-gray-500">Your API secret (stored securely)</p>
    </div>
  <% end %>

  <% unless config[:requires_api_key] || config[:requires_api_secret] %>
    <div class="bg-yellow-50 border border-yellow-200 rounded-md p-4">
      <div class="flex">
        <div class="flex-shrink-0">
          <svg class="h-5 w-5 text-yellow-400" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
          </svg>
        </div>
        <div class="ml-3">
          <h3 class="text-sm font-medium text-yellow-800">Manual Entry Only</h3>
          <p class="mt-2 text-sm text-yellow-700">
            <%= asp_connection.display_name %> does not support automatic data sync.
            You'll need to manually enter your revenue data in the Revenue section.
          </p>
        </div>
      </div>
    </div>
  <% end %>

  <div class="flex justify-end space-x-3">
    <%= link_to "Cancel", site_asp_connections_path(@site),
        class: "px-4 py-2 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50" %>
    <%= form.submit asp_connection.persisted? ? "Update Connection" : "Connect",
        class: "px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-teal-600 hover:bg-teal-700 cursor-pointer" %>
  </div>
<% end %>
