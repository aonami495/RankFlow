<div class="space-y-6">
  <div class="flex justify-between items-center">
    <h1 class="text-2xl font-bold text-gray-900">Dashboard</h1>
    <% if @sites.any? %>
      <%= form_with url: dashboard_path, method: :get, data: { turbo_frame: "_top" }, class: "flex items-center" do %>
        <label for="site_id" class="mr-2 text-sm text-gray-600">Site:</label>
        <%= select_tag :site_id, options_from_collection_for_select(@sites, :id, :name, @current_site&.id),
            class: "block w-48 px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-teal-500 focus:border-teal-500 sm:text-sm",
            onchange: "this.form.submit()" %>
      <% end %>
    <% end %>
  </div>

  <% if @sites.empty? %>
    <div class="bg-white rounded-lg shadow p-8 text-center">
      <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6" />
      </svg>
      <h3 class="mt-2 text-sm font-medium text-gray-900">No sites yet</h3>
      <p class="mt-1 text-sm text-gray-500">Get started by adding your first site.</p>
      <div class="mt-6">
        <%= link_to "Add Site", new_site_path, class: "inline-flex items-center px-4 py-2 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-teal-600 hover:bg-teal-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-teal-500" %>
      </div>
    </div>
  <% else %>
    <% if @failed_keywords_count && @failed_keywords_count > 0 %>
      <div class="bg-yellow-50 border-l-4 border-yellow-400 p-4 rounded-md">
        <div class="flex">
          <div class="flex-shrink-0">
            <svg class="h-5 w-5 text-yellow-400" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
            </svg>
          </div>
          <div class="ml-3">
            <p class="text-sm text-yellow-700">
              <strong><%= @failed_keywords_count %>件</strong>のキーワードで順位取得に失敗しました。
              <span class="text-yellow-600">API制限または通信エラーの可能性があります。後ほど自動的に再取得されます。</span>
            </p>
          </div>
        </div>
      </div>
    <% end %>

    <!-- Site Overview Cards -->
    <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
      <div class="bg-white overflow-hidden shadow rounded-lg">
        <div class="p-5">
          <div class="flex items-center">
            <div class="flex-shrink-0">
              <svg class="h-6 w-6 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
              </svg>
            </div>
            <div class="ml-5 w-0 flex-1">
              <dl>
                <dt class="text-sm font-medium text-gray-500 truncate">Average Rank</dt>
                <dd class="flex items-baseline">
                  <div class="text-2xl font-semibold text-gray-900">
                    <%= @current_site&.respond_to?(:average_rank) ? @current_site.average_rank : "-" %>
                  </div>
                </dd>
              </dl>
            </div>
          </div>
        </div>
      </div>

      <div class="bg-white overflow-hidden shadow rounded-lg">
        <div class="p-5">
          <div class="flex items-center">
            <div class="flex-shrink-0">
              <svg class="h-6 w-6 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z" />
              </svg>
            </div>
            <div class="ml-5 w-0 flex-1">
              <dl>
                <dt class="text-sm font-medium text-gray-500 truncate">Keywords</dt>
                <dd class="flex items-baseline">
                  <div class="text-2xl font-semibold text-gray-900">
                    <%= @current_site&.keywords&.count || 0 %>
                  </div>
                </dd>
              </dl>
            </div>
          </div>
        </div>
      </div>

      <div class="bg-white overflow-hidden shadow rounded-lg">
        <div class="p-5">
          <div class="flex items-center">
            <div class="flex-shrink-0">
              <svg class="h-6 w-6 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <div class="ml-5 w-0 flex-1">
              <dl>
                <dt class="text-sm font-medium text-gray-500 truncate">This Month Revenue</dt>
                <dd class="flex items-baseline">
                  <div class="text-2xl font-semibold text-gray-900">
                    <%= number_to_currency(@current_site&.respond_to?(:total_revenue) ? @current_site.total_revenue : 0, unit: "\u00a5", precision: 0) %>
                  </div>
                </dd>
              </dl>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Charts -->
    <div class="grid grid-cols-1 gap-5 lg:grid-cols-2">
      <div class="bg-white shadow rounded-lg p-6">
        <h3 class="text-lg font-medium text-gray-900 mb-4">Rank Trends (30 Days)</h3>
        <% if @rank_chart_data.present? && @rank_chart_data.any? { |d| d[:data].present? } %>
          <%= line_chart @rank_chart_data, min: 1, max: 100, colors: ["#0d9488", "#14b8a6", "#2dd4bf", "#5eead4", "#99f6e4"], library: { scales: { y: { reverse: true } } } %>
        <% else %>
          <div class="h-64 flex items-center justify-center text-gray-400">
            <p>No rank data available yet</p>
          </div>
        <% end %>
      </div>

      <div class="bg-white shadow rounded-lg p-6">
        <h3 class="text-lg font-medium text-gray-900 mb-4">Revenue (6 Months)</h3>
        <% if @revenue_chart_data.present? && @revenue_chart_data.any? %>
          <%= column_chart @revenue_chart_data, prefix: "¥", colors: ["#0d9488"] %>
        <% else %>
          <div class="h-64 flex items-center justify-center text-gray-400">
            <p>No revenue data available yet</p>
          </div>
        <% end %>
      </div>
    </div>

    <!-- Keywords Table -->
    <div class="bg-white shadow rounded-lg">
      <div class="px-4 py-5 border-b border-gray-200 sm:px-6 flex justify-between items-center">
        <h3 class="text-lg leading-6 font-medium text-gray-900">Keywords</h3>
        <% if @current_site && current_user.can_add_keyword?(@current_site) %>
          <%= link_to new_site_keyword_path(@current_site), class: "inline-flex items-center px-3 py-1.5 border border-transparent text-sm font-medium rounded-md text-white bg-teal-600 hover:bg-teal-700" do %>
            <svg class="-ml-0.5 mr-1.5 h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
            </svg>
            Add Keyword
          <% end %>
        <% end %>
      </div>
      <% if @current_site&.keywords&.any? %>
        <div class="overflow-x-auto">
          <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50">
              <tr>
                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Keyword</th>
                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Current Rank</th>
                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Change</th>
                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">30 Day Trend</th>
                <th scope="col" class="relative px-6 py-3"><span class="sr-only">Actions</span></th>
              </tr>
            </thead>
            <tbody class="bg-white divide-y divide-gray-200">
              <% @current_site.keywords.each do |keyword| %>
                <tr>
                  <td class="px-6 py-4 whitespace-nowrap">
                    <div class="text-sm font-medium text-gray-900"><%= keyword.word %></div>
                    <% if keyword.target_url.present? %>
                      <div class="text-sm text-gray-500 truncate max-w-xs"><%= keyword.target_url %></div>
                    <% end %>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap">
                    <% if keyword.last_check_failed? %>
                      <span class="inline-flex items-center text-sm text-red-600" title="<%= keyword.last_error_message %>">
                        <svg class="mr-1 h-4 w-4" fill="currentColor" viewBox="0 0 20 20">
                          <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
                        </svg>
                        Error
                      </span>
                    <% else %>
                      <% rank = keyword.respond_to?(:current_rank) ? keyword.current_rank : nil %>
                      <% if rank && rank <= 100 %>
                        <span class="text-lg font-semibold text-gray-900"><%= rank %></span>
                      <% elsif rank == 101 %>
                        <span class="text-sm text-gray-500">100+</span>
                      <% else %>
                        <span class="text-sm text-gray-400">-</span>
                      <% end %>
                    <% end %>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap">
                    <% change = keyword.respond_to?(:rank_change) ? keyword.rank_change : nil %>
                    <% if change.nil? %>
                      <span class="text-sm text-gray-400">-</span>
                    <% elsif change > 0 %>
                      <span class="inline-flex items-center text-sm font-medium text-green-600">
                        <svg class="mr-1 h-4 w-4" fill="currentColor" viewBox="0 0 20 20">
                          <path fill-rule="evenodd" d="M5.293 9.707a1 1 0 010-1.414l4-4a1 1 0 011.414 0l4 4a1 1 0 01-1.414 1.414L11 7.414V15a1 1 0 11-2 0V7.414L6.707 9.707a1 1 0 01-1.414 0z" clip-rule="evenodd" />
                        </svg>
                        <%= change %>
                      </span>
                    <% elsif change < 0 %>
                      <span class="inline-flex items-center text-sm font-medium text-red-600">
                        <svg class="mr-1 h-4 w-4" fill="currentColor" viewBox="0 0 20 20">
                          <path fill-rule="evenodd" d="M14.707 10.293a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 111.414-1.414L9 12.586V5a1 1 0 012 0v7.586l2.293-2.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                        </svg>
                        <%= change.abs %>
                      </span>
                    <% else %>
                      <span class="text-sm text-gray-400">-</span>
                    <% end %>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap">
                    <div class="w-24 h-8 bg-gray-100 rounded flex items-center justify-center text-xs text-gray-400">
                      Chart
                    </div>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                    <%= link_to "Edit", edit_site_keyword_path(@current_site, keyword), class: "text-teal-600 hover:text-teal-900" %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <div class="p-8 text-center">
          <p class="text-sm text-gray-500">No keywords yet. Add your first keyword to start tracking.</p>
          <% if @current_site && current_user.can_add_keyword?(@current_site) %>
            <div class="mt-4">
              <%= link_to "Add Keyword", new_site_keyword_path(@current_site), class: "inline-flex items-center px-4 py-2 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-teal-600 hover:bg-teal-700" %>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
