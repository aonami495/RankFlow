<div class="space-y-6">
  <div class="flex justify-between items-center">
    <div>
      <div class="flex items-center">
        <%= link_to site_articles_path(@site), class: "text-gray-400 hover:text-gray-600 mr-2" do %>
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
          </svg>
        <% end %>
        <h1 class="text-2xl font-bold text-gray-900"><%= @article.title %></h1>
      </div>
      <p class="mt-1 text-sm text-gray-500"><%= @article.url %></p>
    </div>
    <div class="flex space-x-3">
      <%= link_to "Edit", edit_site_article_path(@site, @article), class: "inline-flex items-center px-3 py-2 border border-gray-300 shadow-sm text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50" %>
      <%= button_to "Delete", site_article_path(@site, @article), method: :delete, data: { turbo_confirm: "Delete this article?" }, class: "inline-flex items-center px-3 py-2 border border-red-300 shadow-sm text-sm font-medium rounded-md text-red-700 bg-white hover:bg-red-50" %>
    </div>
  </div>

  <!-- Article Stats -->
  <div class="grid grid-cols-1 gap-5 sm:grid-cols-4">
    <div class="bg-white overflow-hidden shadow rounded-lg">
      <div class="p-5">
        <div class="flex items-center">
          <div class="flex-shrink-0">
            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium
              <%= case @article.status_color
                  when 'green' then 'bg-green-100 text-green-800'
                  when 'yellow' then 'bg-yellow-100 text-yellow-800'
                  when 'red' then 'bg-red-100 text-red-800'
                  else 'bg-gray-100 text-gray-800'
                  end %>">
              <%= @article.status_label %>
            </span>
          </div>
          <div class="ml-5 w-0 flex-1">
            <dl>
              <dt class="text-sm font-medium text-gray-500 truncate">Status</dt>
            </dl>
          </div>
        </div>
      </div>
    </div>

    <div class="bg-white overflow-hidden shadow rounded-lg">
      <div class="p-5">
        <dl>
          <dt class="text-sm font-medium text-gray-500 truncate">Average Rank</dt>
          <dd class="text-2xl font-semibold text-gray-900"><%= @article.average_rank || "-" %></dd>
        </dl>
      </div>
    </div>

    <div class="bg-white overflow-hidden shadow rounded-lg">
      <div class="p-5">
        <dl>
          <dt class="text-sm font-medium text-gray-500 truncate">Keywords</dt>
          <dd class="text-2xl font-semibold text-gray-900"><%= @keywords.count %></dd>
        </dl>
      </div>
    </div>

    <div class="bg-white overflow-hidden shadow rounded-lg">
      <div class="p-5">
        <dl>
          <dt class="text-sm font-medium text-gray-500 truncate">This Month Revenue</dt>
          <dd class="text-2xl font-semibold text-gray-900"><%= number_to_currency(@article.monthly_revenue, unit: "\u00a5", precision: 0) %></dd>
        </dl>
      </div>
    </div>
  </div>

  <!-- Rewrite Alert -->
  <% if @article.needs_rewrite? %>
    <div class="bg-yellow-50 border border-yellow-200 rounded-md p-4">
      <div class="flex">
        <div class="flex-shrink-0">
          <svg class="h-5 w-5 text-yellow-400" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
          </svg>
        </div>
        <div class="ml-3">
          <h3 class="text-sm font-medium text-yellow-800">Rewrite Recommended</h3>
          <p class="mt-2 text-sm text-yellow-700">
            Some keywords for this article have dropped significantly in rank. Consider updating the content.
          </p>
        </div>
      </div>
    </div>
  <% end %>

  <!-- Associated Keywords -->
  <div class="bg-white shadow rounded-lg">
    <div class="px-4 py-5 border-b border-gray-200 sm:px-6 flex justify-between items-center">
      <h3 class="text-lg leading-6 font-medium text-gray-900">Associated Keywords</h3>
    </div>

    <% if @keywords.any? %>
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200">
          <thead class="bg-gray-50">
            <tr>
              <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Keyword</th>
              <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Current Rank</th>
              <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Change</th>
              <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Trend</th>
            </tr>
          </thead>
          <tbody class="bg-white divide-y divide-gray-200">
            <% @keywords.each do |keyword| %>
              <tr>
                <td class="px-6 py-4 whitespace-nowrap">
                  <div class="text-sm font-medium text-gray-900"><%= keyword.word %></div>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                  <% rank = keyword.current_rank %>
                  <% if rank && rank <= 100 %>
                    <span class="text-lg font-semibold text-gray-900"><%= rank %></span>
                  <% elsif rank == 101 %>
                    <span class="text-sm text-gray-500">100+</span>
                  <% else %>
                    <span class="text-sm text-gray-400">-</span>
                  <% end %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                  <% change = keyword.rank_change %>
                  <% if change.nil? %>
                    <span class="text-sm text-gray-400">-</span>
                  <% elsif change > 0 %>
                    <span class="inline-flex items-center text-sm font-medium text-green-600">
                      <svg class="mr-1 h-4 w-4" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M5.293 9.707a1 1 0 010-1.414l4-4a1 1 0 011.414 0l4 4a1 1 0 01-1.414 1.414L11 7.414V15a1 1 0 11-2 0V7.414L6.707 9.707a1 1 0 01-1.414 0z" clip-rule="evenodd" />
                      </svg>
                      <%= change %>
                    </span>
                  <% elsif change < 0 %>
                    <span class="inline-flex items-center text-sm font-medium text-red-600">
                      <svg class="mr-1 h-4 w-4" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M14.707 10.293a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 111.414-1.414L9 12.586V5a1 1 0 012 0v7.586l2.293-2.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                      </svg>
                      <%= change.abs %>
                    </span>
                  <% else %>
                    <span class="text-sm text-gray-400">-</span>
                  <% end %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                  <% trend = keyword.rank_trend %>
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium
                    <%= case trend
                        when :improving then 'bg-green-100 text-green-800'
                        when :declining then 'bg-red-100 text-red-800'
                        when :stable then 'bg-gray-100 text-gray-800'
                        else 'bg-gray-100 text-gray-800'
                        end %>">
                    <%= trend.to_s.humanize %>
                  </span>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="p-8 text-center">
        <p class="text-sm text-gray-500">No keywords associated with this article yet.</p>
      </div>
    <% end %>
  </div>
</div>
